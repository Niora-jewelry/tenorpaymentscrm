# TapDash CRM — environment template.
#
# ⚠️ THIS FILE IS COMMITTED. Every value below is a PLACEHOLDER and must stay
# one. `.gitignore` ignores `.env*` and then force-includes this single file, so
# anything real typed here goes straight into the repository. Put real values in
# `.env` (ignored) locally, and in the Vercel project settings for deployments.
#
# Copy to `.env` and fill in from the Supabase dashboard:
#   Project Settings → API           → URL, anon key, service_role key
#   Project Settings → Database      → connection string (Session pooler)

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres, used by the migration and seed scripts only. Never reaches
# the browser and never runs on the Edge runtime.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# --- App ---------------------------------------------------------------------
# The deployed origin. Used to build absolute links and to bound redirects, so
# it must match the real domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Content-Security-Policy: report-only when false, enforced when true.
CSP_ENFORCE=false

# --- Secrets -----------------------------------------------------------------
# Generate each one with:  openssl rand -base64 32
#
# OTP_PEPPER   salts the one-time-code hashes. Changing it invalidates every
#              outstanding code, which is harmless — they expire in 10 minutes.
#
# LOGIN_ENC_KEY encrypts stored merchant credentials (the Logins tab).
#              ⚠️ Changing this makes every already-stored password
#              unreadable. Rotate it only with a re-encryption plan.
OTP_PEPPER=generate-me-openssl-rand-base64-32
LOGIN_ENC_KEY=generate-me-openssl-rand-base64-32

# --- Transactional email -----------------------------------------------------
# Transactional email, over SMTP. Verified against Microsoft 365:
#   host smtp-mail.outlook.com, port 587, STARTTLS.
# SMTP_PASSWORD is an APP PASSWORD -- Microsoft refuses the mailbox password
# once MFA is on, which fails looking exactly like a wrong credential.
# Leave SMTP_HOST blank in development and codes print to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="TapDash <no-reply@example.com>"

# --- Demo login (development only) -------------------------------------------
# A temporary stand-in so the product is clickable before Supabase is connected.
# NOT an auth bypass: it checks this exact pair and nothing else, and the app
# THROWS on startup if it is enabled while NODE_ENV=production.
DEMO_AUTH_ENABLED=false
DEMO_AUTH_EMAIL=demo@example.com
DEMO_AUTH_PASSWORD=
DEMO_AUTH_SECRET=
NEXT_PUBLIC_DEMO_HINT=

# --- Prototype access --------------------------------------------------------
# Gate for the static prototype routes. Ignored in development.
PROTOTYPE_ACCESS_CODE=

# ── Twilio (phone module) ─────────────────────────────────────────────────
# Real values live in .env and in the Vercel project settings — never here.
# The account is the client's own and is upgraded (no trial restrictions).
TWILIO_ACCOUNT_SID=AC_your_account_sid
TWILIO_API_KEY_SID=SK_your_api_key_sid
TWILIO_API_KEY_SECRET=your_api_key_secret
TWILIO_TWIML_APP_SID=AP_your_twiml_app_sid
# ⚠ Webhook signatures are HMAC-SHA1 with the ACCOUNT auth token, NOT the API
# key secret. If this is unset every signed webhook route rejects its request —
# the callback surface fails closed, which is correct but total.
TWILIO_AUTH_TOKEN=your_account_auth_token

# ── PostHog (session replay) ──────────────────────────────────────────────
# BOTH the on/off switch and the configuration. With no key, posthog.init is
# never called: nothing is recorded, nothing is sent, and the PostHog hosts are
# left out of the CSP. Set it in Vercel to turn recording on; remove it to turn
# recording off. Neither needs a code change.
#
# ⚠ RECORDING HERE IS UNMASKED BY INSTRUCTION. A replay shows real values,
# including SSN, EIN, bank account and routing numbers, and any processor
# password revealed on the Logins tab. A replay is an export of all of it, so
# whoever can open the PostHog project can read it — treat that account list as
# being as sensitive as an admin login to this CRM, and set PostHog's retention
# accordingly. See the header of src/app/(app)/PostHogProvider.tsx.
NEXT_PUBLIC_POSTHOG_KEY=
# Region host. Defaults to https://us.i.posthog.com; use https://eu.i.posthog.com
# for an EU project. The assets host is derived from it in next.config.ts.
NEXT_PUBLIC_POSTHOG_HOST=

# ── Email module (Outlook / Microsoft 365 via Microsoft Graph) ───────────
# All optional: the module is off (no nav item, /email redirects) until the
# required ones are set. See docs/mail-azure-setup.md for the Azure steps.
#
# The Azure app registration (Entra → App registrations, multitenant work/school
# accounts only, delegated permissions only).
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
# ISO date the client secret expires — admins are warned 30 days before.
MAIL_CLIENT_SECRET_EXPIRES_AT=
# HMAC key for the OAuth state cookie. ≥32 chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAIL_STATE_SIGNING_SECRET=
# AES-256-GCM key for stored Microsoft tokens. 32 random bytes, base64 (same command).
# ⚠ Kept OUT of the database on purpose. Changing it orphans every stored token —
# rotate only with scripts/mail-rotate-token-key.mjs.
MAIL_TOKEN_ENC_KEY=
# Optional: comma-separated Entra tenant ids allowed to connect. Blank = any work tenant.
MAIL_ALLOWED_TENANT_IDS=
# Optional: only for a local HTTPS tunnel. Default ${NEXT_PUBLIC_APP_URL}/api/mail/oauth/callback
MAIL_REDIRECT_URI=
# Graph change notifications. 'true' only in production (previews must never
# register subscriptions pointing at themselves; they poll instead).
MAIL_WEBHOOKS_ENABLED=
# Kill switch. 'false' hides the module without removing configuration.
MAIL_MODULE_ENABLED=
# 'graph' (default) or 'mock' for the local Graph stand-in (refused in production).
MAIL_PROVIDER=
MAIL_MOCK_BASE_URL=
# Vercel sends this as "Authorization: Bearer …" on cron calls to /api/mail/tick.
CRON_SECRET=
