{
    "name": "tapdash-crm",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "db:start": "supabase start",
        "db:reset": "supabase db reset",
        "db:push": "supabase db push",
        "db:types": "supabase gen types typescript --local > src/lib/db/types.ts",
        "verify": "npm run typecheck && npm run lint && npm run test",
        "verify:schema": "node scripts/verify-schema.mjs",
        "verify:posthog": "node --env-file=.env scripts/verify-posthog.mjs",
        "verify:consent": "node --env-file=.env scripts/verify-sms-consent.mjs",
        "verify:newtext": "node --env-file=.env scripts/verify-new-text.mjs",
        "verify:choices": "node --env-file=.env scripts/verify-choices-admin.mjs",
        "verify:member": "node --env-file=.env scripts/verify-as-member.mjs",
        "verify:bulk": "node --env-file=.env scripts/verify-bulk-edit.mjs",
        "verify:bulk-permissions": "node --env-file=.env scripts/verify-permissions-bulk.mjs",
        "verify:member-permissions": "node --env-file=.env scripts/verify-member-permissions.mjs",
        "verify:case-controls": "node --env-file=.env scripts/verify-case-controls.mjs",
        "verify:mail-connect": "node --env-file=.env scripts/verify-mail-connect.mjs",
        "verify:mail-sync": "node --env-file=.env scripts/verify-mail-sync.mjs",
        "mail:mock": "node scripts/mail-mock-graph.mjs",
        "test:integration": "vitest run --dir src --testTimeout 60000 flow.integration",
        "invite": "node scripts/invite.mjs",
        "create-user": "node --env-file=.env scripts/create-user.mjs",
        "audit": "node scripts/audit-tail.mjs"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@supabase/ssr": "^0.12.4",
        "@supabase/supabase-js": "^2.112.2",
        "@twilio/voice-sdk": "^2.18.5",
        "fflate": "^0.8.3",
        "html-to-text": "^10.0.1",
        "isomorphic-dompurify": "^3.19.0",
        "next": "16.3.0",
        "nodemailer": "^10.0.10",
        "pdfjs-dist": "^4.8.69",
        "posthog-js": "^1.203.1",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "server-only": "^0.0.1",
        "twilio": "^5.13.1",
        "undici": "^8.12.2",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/html-to-text": "^9.0.4",
        "@types/node": "^20",
        "@types/nodemailer": "^8.0.2",
        "@types/pg": "^8.21.0",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitest/ui": "^4.1.10",
        "eslint": "^9",
        "eslint-config-next": "16.3.0",
        "pg": "^8.23.0",
        "playwright": "^1.49.1",
        "supabase": "^2.113.0",
        "tailwindcss": "^4",
        "tsx": "^4.23.15",
        "typescript": "^5",
        "vitest": "^4.1.10"
    }
}
